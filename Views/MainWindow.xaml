<Window x:Class="EzPrayer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EzPrayer - Al-Quran" Height="600" Width="900"
        Background="#1E1E1E" WindowStartupLocation="CenterScreen"
        Closed="Window_Closed">

    <Window.Resources>
        <Style x:Key="ArabicTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource AmiriFont}" />
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="LineHeight" Value="60"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ListBox x:Name="SurahListBox" Grid.Column="0" Background="#252526" Foreground="White" 
                 BorderThickness="0" SelectionChanged="SurahListBox_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="10">
                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="16"/>
                        <TextBlock Text="{Binding NameTranslations.Id}" FontSize="12" Foreground="Gray"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="30">
            <StackPanel>
                <TextBlock x:Name="SurahTitle" FontSize="28" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>
                
                <Button x:Name="PlayMurottalButton" Content="▶ Putar Murottal" 
                        HorizontalAlignment="Left" Margin="0,0,0,20"
                        Padding="10,5" Background="#3A3A3A" Foreground="White" BorderThickness="0"
                        Click="PlayMurottalButton_Click"/>

                <TextBlock x:Name="BismillahText" Text="بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ" 
                           FontSize="32" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,30"
                           FontFamily="{DynamicResource AmiriFont}"/>

                <ItemsControl x:Name="VersesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,20">
                                
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Teks Arab -->
                                    <TextBlock Grid.Column="0" Text="{Binding Text}" Style="{StaticResource ArabicTextStyle}" 
                                               VerticalAlignment="Center"/>
                                    
                                    <!-- Ornamen & Angka (Ditumpuk) -->
                                    <Grid Grid.Column="1" Width="50" Height="50" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <!-- 1. Ornamen (Lingkaran) -->
                                        <TextBlock Text="۝" FontFamily="{DynamicResource AmiriFont}" 
                                                   FontSize="55" Foreground="#FFD700"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        
                                        <!-- 2. Angka Arab (Ditumpuk di atas ornamen) -->
                                        <TextBlock Text="{Binding ArabicNumber}" 
                                                   FontFamily="{DynamicResource AmiriFont}" 
                                                   FontSize="16" Foreground="#FFD700"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Margin="0,0,0,0"/> <!-- Margin dihapus agar pas di tengah -->
                                    </Grid>
                                </Grid>

                                <TextBlock Text="{Binding Translation}" FontSize="16" Foreground="#CCCCCC" 
                                           TextWrapping="Wrap" Margin="0,10,0,0"/>
                                <Separator Background="#333333" Margin="0,10,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>