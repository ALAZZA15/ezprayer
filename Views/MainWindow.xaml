<Window x:Class="EzPrayer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EzPrayer" Height="760" Width="1180" MinHeight="650" MinWidth="1000"
        Background="#101720" WindowStartupLocation="CenterScreen"
        Closed="Window_Closed">
    <Window.Resources>
        <Style x:Key="NavigationButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#C8D2E0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>
        <Style x:Key="ArabicTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource AmiriFont}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="LineHeight" Value="60"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>
        <Style x:Key="PrayerRowStyle" TargetType="Border">
            <Setter Property="Background" Value="#172433"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>
        <Style x:Key="CalendarDayButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#33202D3C"/>
            <Setter Property="Foreground" Value="#EAF2FA"/>
            <Setter Property="BorderBrush" Value="#223C4D60"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="3"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="MinHeight" Value="58"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsToday}" Value="True">
                    <Setter Property="Background" Value="#664A90C2"/>
                    <Setter Property="BorderBrush" Value="#63B3FF"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="#FF1677C8"/>
                    <Setter Property="BorderBrush" Value="#FFA6D8FF"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AboutAccentButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1C4E78"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.86"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="AppRootGrid" Background="#101720">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="SidebarBorder" Grid.Column="0" Background="#141E2B" Padding="18,24">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="EzPrayer" FontSize="25" FontWeight="Bold"
                               Foreground="#63B3FF" Margin="10,0,0,28"/>
                    <Button Style="{StaticResource NavigationButtonStyle}" Content="⌂   Beranda"
                            Tag="Home" Click="NavigationButton_Click"/>
                    <Button Style="{StaticResource NavigationButtonStyle}" Content="۞   Al-Quran"
                            Tag="Quran" Click="NavigationButton_Click"/>
                    <Button Style="{StaticResource NavigationButtonStyle}" Content="▦   Kalender"
                            Tag="Calendar" Click="NavigationButton_Click"/>
                    <Button Style="{StaticResource NavigationButtonStyle}" Content="♫   Murottal"
                            Tag="Murottal" Click="NavigationButton_Click"/>
                    <Button Style="{StaticResource NavigationButtonStyle}" Content="⚙   Pengaturan"
                            Tag="Settings" Click="NavigationButton_Click"/>
                    <Button Style="{StaticResource NavigationButtonStyle}" Content="ⓘ   Tentang"
                            Tag="About" Click="NavigationButton_Click"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="Jadwal sholat dan Al-Quran"
                           Foreground="#718096" FontSize="11" Margin="10,12,0,0"/>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="26">
            <Grid x:Name="HomePage" Visibility="Visible">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Assalamu'alaikum" FontSize="30" FontWeight="SemiBold"
                                   Foreground="White"/>
                        <TextBlock x:Name="TodaySummaryText" FontSize="15" Foreground="#AAB8C8"
                                   Margin="0,6,0,2"/>
                        <TextBlock x:Name="TodayHijriText" FontSize="14" Foreground="#7FC3FF"/>

                        <Border x:Name="HomeHighlightBorder" Background="#1C4E78" CornerRadius="18" Padding="24"
                                Margin="0,24,0,18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="SHOLAT BERIKUTNYA" Foreground="#C5E5FF"
                                               FontSize="12" FontWeight="Bold"/>
                                    <TextBlock x:Name="NextPrayerNameText" FontSize="25"
                                               FontWeight="SemiBold" Foreground="White" Margin="0,6,0,0"/>
                                    <TextBlock x:Name="NextPrayerCountdownText" FontSize="16"
                                               Foreground="#D9EEFF" Margin="0,3,0,0"/>
                                    <TextBlock x:Name="HomeCityText" FontSize="13"
                                               Foreground="#B4D7F3" Margin="0,8,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Lanjut baca Quran  →"
                                        VerticalAlignment="Center" Padding="16,12"
                                        Background="#E5F3FF" Foreground="#123653"
                                        BorderThickness="0" FontWeight="SemiBold"
                                        Click="ContinueReadingButton_Click"/>
                            </Grid>
                        </Border>

                        <TextBlock Text="Jadwal sholat hari ini" FontSize="20"
                                   FontWeight="SemiBold" Foreground="White" Margin="0,8,0,8"/>
                        <ItemsControl x:Name="TodayPrayerList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource PrayerRowStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" Foreground="#E8F0FA"
                                                       FontSize="15"/>
                                            <TextBlock Grid.Column="1" Text="{Binding FormattedTime}"
                                                       Foreground="#85C8FF" FontSize="15"
                                                       FontWeight="SemiBold"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Grid x:Name="QuranPage" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Background="#17212D">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="170"/>
                    </Grid.RowDefinitions>
                    <TextBox x:Name="QuranSearchBox" Grid.Row="0" Margin="8"
                             Padding="8" FontSize="14"
                             ToolTip="Cari nama surah atau kata pada teks Arab/terjemahan"
                             TextChanged="QuranSearchBox_TextChanged"/>
                    <TextBlock x:Name="QuranSearchStatusText" Grid.Row="1" Margin="10,0,10,5"
                               FontSize="11" Foreground="#91A4B8"/>
                    <ListBox x:Name="SurahListBox" Grid.Row="2" Background="#17212D"
                             Foreground="White" BorderThickness="0"
                             SelectionChanged="SurahListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="10">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="16"/>
                                    <TextBlock Text="{Binding NameTranslations.Id}" FontSize="12"
                                               Foreground="#8A9AAA"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <ListBox x:Name="QuranSearchResultsList" Grid.Row="2" Background="#17212D"
                             Foreground="White" BorderThickness="0" Visibility="Collapsed"
                             SelectionChanged="QuranSearchResultsList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="9">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                               Foreground="#EAF2FA" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Description}" FontSize="12"
                                               Foreground="#9DADBD" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Grid.Row="3" Text="Bookmark" FontWeight="SemiBold"
                               Foreground="#C5E5FF" Margin="10,7,10,4"/>
                    <ListBox x:Name="BookmarksListBox" Grid.Row="4" Background="#17212D"
                             Foreground="White" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Button Content="{Binding Title}" HorizontalContentAlignment="Left"
                                            Padding="3" Background="Transparent" Foreground="White"
                                            BorderThickness="0" Click="OpenBookmarkButton_Click"/>
                                    <TextBlock Grid.Row="1" Text="{Binding Description}"
                                               FontSize="11" Foreground="#91A4B8"
                                               TextTrimming="CharacterEllipsis" Margin="3,0,4,0"/>
                                    <Button Grid.Column="1" Grid.RowSpan="2" Content="Hapus"
                                            Padding="5,2" VerticalAlignment="Center"
                                            Click="RemoveBookmarkButton_Click"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="26,12,8,12">
                    <StackPanel>
                        <TextBlock x:Name="SurahTitle" FontSize="28" FontWeight="Bold"
                                   Foreground="White" Margin="0,0,0,10"/>
                        <TextBlock x:Name="QuranStatusText" Foreground="#85C8FF"
                                   Margin="0,0,0,10"/>
                        <Button x:Name="PlayMurottalButton" Content="▶ Putar Murottal"
                                HorizontalAlignment="Left" Margin="0,0,0,20"
                                Padding="10,5" Background="#263747" Foreground="White"
                                BorderThickness="0" Click="PlayMurottalButton_Click"/>
                        <TextBlock x:Name="BismillahText"
                                   Text="بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ"
                                   FontSize="32" Foreground="White" HorizontalAlignment="Center"
                                   Margin="0,0,0,30" FontFamily="{DynamicResource AmiriFont}"/>
                        <ItemsControl x:Name="VersesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,20">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Text}"
                                                       Style="{StaticResource ArabicTextStyle}"
                                                       FontSize="{Binding ArabicFontSize, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                       VerticalAlignment="Center"/>
                                            <Grid Grid.Column="1" Width="50" Height="50"
                                                  Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="۝" FontFamily="{DynamicResource AmiriFont}"
                                                           FontSize="55" Foreground="#63B3FF"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding ArabicNumber}"
                                                           FontFamily="{DynamicResource AmiriFont}"
                                                           FontSize="16" Foreground="#63B3FF"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Grid>
                                        <TextBlock Text="{Binding Translation}"
                                                   FontSize="{Binding TranslationFontSize, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                   Foreground="#C5D0DC" TextWrapping="Wrap"
                                                   Margin="0,10,0,0"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                    Margin="0,8,0,0">
                                            <Button Content="☆ Bookmark" Padding="8,4"
                                                    Click="BookmarkVerseButton_Click"/>
                                            <Button Content="Tandai terakhir dibaca" Padding="8,4"
                                                    Margin="8,0,0,0"
                                                    Click="MarkLastReadVerseButton_Click"/>
                                        </StackPanel>
                                        <Separator Background="#344252" Margin="0,10,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Grid x:Name="CalendarPage" Visibility="Collapsed">
                <Border x:Name="CalendarBackgroundBorder" CornerRadius="24" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Hari ini" FontSize="13" Foreground="#C5E5FF"/>
                                <TextBlock x:Name="CalendarTodayText" FontSize="19"
                                           FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock x:Name="CalendarClockText" FontSize="14"
                                           Foreground="#C5D0DC" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,16,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="CalendarMonthText" FontSize="25"
                                           FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock x:Name="CalendarHijriMonthText" FontSize="14"
                                           Foreground="#C5E5FF" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Button Content="‹" Width="38" Height="36" Margin="0,0,6,0"
                                        Click="PreviousMonthButton_Click"/>
                                <Button Content="Hari ini" Padding="10,5" Margin="0,0,6,0"
                                        Click="CalendarTodayButton_Click"/>
                                <Button Content="›" Width="38" Height="36"
                                        Click="NextMonthButton_Click"/>
                            </StackPanel>
                        </Grid>

                        <UniformGrid Grid.Row="2" Columns="7" Margin="0,0,0,3">
                            <TextBlock Text="Sen" Foreground="#C5D0DC" HorizontalAlignment="Center"/>
                            <TextBlock Text="Sel" Foreground="#C5D0DC" HorizontalAlignment="Center"/>
                            <TextBlock Text="Rab" Foreground="#C5D0DC" HorizontalAlignment="Center"/>
                            <TextBlock Text="Kam" Foreground="#C5D0DC" HorizontalAlignment="Center"/>
                            <TextBlock Text="Jum" Foreground="#C5D0DC" HorizontalAlignment="Center"/>
                            <TextBlock Text="Sab" Foreground="#C5D0DC" HorizontalAlignment="Center"/>
                            <TextBlock Text="Min" Foreground="#C5D0DC" HorizontalAlignment="Center"/>
                        </UniformGrid>

                        <ItemsControl x:Name="CalendarDaysList" Grid.Row="3">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="7" Rows="6"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource CalendarDayButtonStyle}"
                                            IsEnabled="{Binding IsSelectable}"
                                            Click="CalendarDayButton_Click">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DayNumber}"
                                                       HorizontalAlignment="Center"
                                                       FontSize="16" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding HijriDay}"
                                                       HorizontalAlignment="Center"
                                                       FontSize="10" Foreground="#C5D0DC"
                                                       Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Grid.Row="4" Background="#99202D3C" CornerRadius="12"
                                Padding="14,10" Margin="0,9,0,0">
                            <TextBlock x:Name="CalendarSelectedDateText" FontSize="14"
                                       Foreground="White"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="SettingsPage" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4,0,8,0">
                        <TextBlock Text="Pengaturan" FontSize="30" FontWeight="SemiBold"
                                   Foreground="White"/>
                        <TextBlock Text="Atur jadwal, tampilan, dan suara aplikasi."
                                   Foreground="#AAB8C8" Margin="0,5,0,18"/>

                        <Border Background="#172433" CornerRadius="14" Padding="20" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Kota" Foreground="#D7E2EE" VerticalAlignment="Center"
                                           Margin="0,0,12,12"/>
                                <DockPanel Grid.Column="1" Margin="0,0,0,12">
                                    <Button x:Name="DetectLocationButton" DockPanel.Dock="Right"
                                            Content="Deteksi lokasi" Padding="9,5"
                                            Margin="8,0,0,0"
                                            Click="DetectLocationButton_Click"/>
                                    <ComboBox x:Name="SettingsLocationComboBox"
                                              DisplayMemberPath="Name" Padding="7"/>
                                </DockPanel>
                                <TextBlock Grid.Row="1" Text="Metode perhitungan"
                                           Foreground="#D7E2EE" VerticalAlignment="Center"
                                           Margin="0,0,12,12"/>
                                <ComboBox x:Name="SettingsCalculationMethodComboBox"
                                          Grid.Row="1" Grid.Column="1" DisplayMemberPath="Name"
                                          Padding="7" Margin="0,0,0,12"/>
                                <TextBlock Grid.Row="2" Text="Koreksi Hijriah"
                                           Foreground="#D7E2EE" VerticalAlignment="Center"
                                           Margin="0,0,12,12"/>
                                <ComboBox x:Name="SettingsHijriAdjustmentComboBox"
                                          Grid.Row="2" Grid.Column="1" Padding="7"
                                          Margin="0,0,0,12" SelectedValuePath="Tag">
                                    <ComboBoxItem Content="-1 hari" Tag="-1"/>
                                    <ComboBoxItem Content="Tanpa koreksi" Tag="0"/>
                                    <ComboBoxItem Content="+1 hari" Tag="1"/>
                                </ComboBox>
                                <TextBlock Grid.Row="3" Text="Tema aplikasi"
                                           Foreground="#D7E2EE" VerticalAlignment="Center"
                                           Margin="0,0,12,12"/>
                                <ComboBox x:Name="SettingsThemeComboBox" Grid.Row="3"
                                          Grid.Column="1" Padding="7" Margin="0,0,0,12"/>
                                <CheckBox x:Name="SettingsAutostartCheckBox" Grid.Row="4"
                                          Grid.ColumnSpan="2"
                                          Content="Jalankan EzPrayer saat Windows dimulai"
                                          Foreground="#EAF2FA" Margin="0,5,0,0"/>
                                <CheckBox x:Name="SettingsKahfAutoplayCheckBox" Grid.Row="5"
                                          Grid.ColumnSpan="2"
                                          Content="Putar murottal Al-Kahf setiap Jumat pukul 08:00"
                                          Foreground="#EAF2FA" Margin="0,10,0,0"/>
                            </Grid>
                        </Border>

                        <Border Background="#172433" CornerRadius="14" Padding="20" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Ukuran teks Al-Quran" FontSize="19"
                                           FontWeight="SemiBold" Foreground="White"
                                           Margin="0,0,0,12"/>
                                <DockPanel>
                                    <TextBlock Text="Arab" Foreground="#D7E2EE"
                                               Width="170" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ArabicFontSizeText" DockPanel.Dock="Right"
                                               Foreground="#85C8FF" Width="48"
                                               TextAlignment="Right" VerticalAlignment="Center"/>
                                    <Slider x:Name="ArabicFontSizeSlider" Minimum="18" Maximum="56"
                                            TickFrequency="1" IsSnapToTickEnabled="True"
                                            ValueChanged="ArabicFontSizeSlider_ValueChanged"/>
                                </DockPanel>
                                <DockPanel Margin="0,12,0,0">
                                    <TextBlock Text="Terjemahan" Foreground="#D7E2EE"
                                               Width="170" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TranslationFontSizeText" DockPanel.Dock="Right"
                                               Foreground="#85C8FF" Width="48"
                                               TextAlignment="Right" VerticalAlignment="Center"/>
                                    <Slider x:Name="TranslationFontSizeSlider" Minimum="12" Maximum="32"
                                            TickFrequency="1" IsSnapToTickEnabled="True"
                                            ValueChanged="TranslationFontSizeSlider_ValueChanged"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="#172433" CornerRadius="14" Padding="20" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Suara adzan" FontSize="19" FontWeight="SemiBold"
                                           Foreground="White" Margin="0,0,0,12"/>
                                <DockPanel Margin="0,0,0,14">
                                    <TextBlock x:Name="AdhanVolumeText" DockPanel.Dock="Right"
                                               Foreground="#85C8FF" VerticalAlignment="Center"
                                               Margin="12,0,0,0"/>
                                    <Slider x:Name="AdhanVolumeSlider" Minimum="0" Maximum="100"
                                            TickFrequency="5" IsSnapToTickEnabled="True"
                                            ValueChanged="AdhanVolumeSlider_ValueChanged"/>
                                </DockPanel>
                                <TextBlock Text="Adzan biasa" Foreground="#D7E2EE"/>
                                <DockPanel Margin="0,5,0,12">
                                    <Button DockPanel.Dock="Right" Content="Bawaan"
                                            Padding="10,5" Margin="8,0,0,0"
                                            Click="ResetAdhanFileButton_Click"/>
                                    <Button DockPanel.Dock="Right" Content="Pilih file..."
                                            Padding="10,5" Margin="8,0,0,0"
                                            Click="SelectAdhanFileButton_Click"/>
                                    <TextBox x:Name="AdhanAudioPathTextBox" IsReadOnly="True"
                                             Padding="7" Background="#101720" Foreground="#C5D0DC"
                                             BorderBrush="#344252"/>
                                </DockPanel>
                                <TextBlock Text="Adzan Subuh" Foreground="#D7E2EE"/>
                                <DockPanel Margin="0,5,0,4">
                                    <Button DockPanel.Dock="Right" Content="Bawaan"
                                            Padding="10,5" Margin="8,0,0,0"
                                            Click="ResetSubuhAdhanFileButton_Click"/>
                                    <Button DockPanel.Dock="Right" Content="Pilih file..."
                                            Padding="10,5" Margin="8,0,0,0"
                                            Click="SelectSubuhAdhanFileButton_Click"/>
                                    <TextBox x:Name="SubuhAdhanAudioPathTextBox" IsReadOnly="True"
                                             Padding="7" Background="#101720" Foreground="#C5D0DC"
                                             BorderBrush="#344252"/>
                                </DockPanel>
                                <TextBlock Text="Kosongkan pilihan file untuk memakai suara bawaan."
                                           FontSize="12" Foreground="#8999AA" Margin="0,0,0,10"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Tes adzan" Padding="10,6"
                                            Click="TestAdhanButton_Click"/>
                                    <Button Content="Tes adzan Subuh" Padding="10,6" Margin="8,0,0,0"
                                            Click="TestSubuhAdhanButton_Click"/>
                                    <Button Content="Stop" Padding="10,6" Margin="8,0,0,0"
                                            Click="StopAdhanPreviewButton_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    Margin="0,0,0,12">
                            <TextBlock x:Name="SettingsStatusText" Foreground="#85C8FF"
                                       VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Button Content="Simpan pengaturan" Padding="14,8"
                                    Click="SaveSettingsButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Grid x:Name="MurottalPage" Visibility="Collapsed">
                <Border x:Name="MurottalBackgroundBorder" CornerRadius="24" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Margin="4,0,0,16">
                            <TextBlock Text="Murottal" FontSize="30" FontWeight="SemiBold"
                                       Foreground="White"/>
                            <TextBlock Text="Pilih surah untuk memutar lantunan Al-Quran."
                                       Foreground="#AAB8C8" Margin="0,5,0,0"/>
                        </StackPanel>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="280"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ListBox x:Name="MurottalSurahListBox" Background="#17212D"
                                     Foreground="White" BorderThickness="0"
                                     SelectionChanged="MurottalSurahListBox_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="9">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                       FontSize="15"/>
                                            <TextBlock Text="{Binding NameTranslations.Id}"
                                                       Foreground="#91A4B8" FontSize="12"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Border x:Name="MurottalPlayerCard" Grid.Column="1"
                                    Background="#172433" CornerRadius="18" Padding="28"
                                    Margin="16,0,0,0">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="SEDANG DIPILIH" FontSize="12"
                                               FontWeight="Bold" Foreground="#85C8FF"/>
                                    <TextBlock x:Name="MurottalNowPlayingText" Text="Pilih surah"
                                               FontSize="27" FontWeight="SemiBold"
                                               Foreground="White" Margin="0,8,0,24"/>
                                    <Slider x:Name="MurottalProgressSlider" Minimum="0"
                                            Maximum="1" IsEnabled="False"
                                            ValueChanged="MurottalProgressSlider_ValueChanged"/>
                                    <Grid Margin="0,4,0,20">
                                        <TextBlock x:Name="MurottalElapsedText" Text="00:00"
                                                   Foreground="#AAB8C8"/>
                                        <TextBlock x:Name="MurottalDurationText" Text="00:00"
                                                   HorizontalAlignment="Right"
                                                   Foreground="#AAB8C8"/>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button x:Name="MurottalPlayPauseButton" Content="▶ Putar"
                                                Padding="16,9" MinWidth="110"
                                                Click="MurottalPlayPauseButton_Click"/>
                                        <Button Content="⏹ Stop" Padding="16,9"
                                                Margin="10,0,0,0"
                                                Click="MurottalStopButton_Click"/>
                                    </StackPanel>
                                    <TextBlock x:Name="MurottalStatusText" Foreground="#85C8FF"
                                               TextAlignment="Center" Margin="0,16,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="AboutPage" Visibility="Collapsed">
                <Border x:Name="AboutBackgroundBorder" CornerRadius="24" Padding="24">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <Border x:Name="AboutCardBorder" Background="#172433" CornerRadius="20"
                                Padding="36" Width="720" MaxWidth="720"
                                HorizontalAlignment="Center" Margin="0,8">
                            <StackPanel>
                                <Image x:Name="AboutLogoImage" Width="120" Height="120"
                                       HorizontalAlignment="Center" Margin="0,0,0,16"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock x:Name="AboutTitleText" Text="EzPrayer" FontSize="32"
                                           FontWeight="Bold" Foreground="White"
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Name="AboutVersionText" FontSize="14"
                                           Foreground="#AAB8C8" HorizontalAlignment="Center"
                                           Margin="0,5,0,12"/>
                                <TextBlock x:Name="AboutSloganText"
                                           Text="Jadwal sholat, Al-Quran, dan kalender dalam satu aplikasi"
                                           FontSize="17" FontWeight="SemiBold"
                                           Foreground="#85C8FF" TextAlignment="Center"
                                           TextWrapping="Wrap" Margin="0,0,0,18"/>
                                <TextBlock x:Name="AboutDescriptionText"
                                           Text="EzPrayer adalah aplikasi desktop untuk Windows yang menampilkan jadwal sholat, adzan otomatis, Al-Quran, murottal, dan kalender Masehi dan Hijriah. EzPrayer dikembangkan dan berada di bawah naungan Azza Corporation."
                                           Foreground="#D7E2EE" TextWrapping="Wrap"
                                           LineHeight="23" Margin="0,0,0,20"/>
                                <TextBlock x:Name="AboutFeaturesHeaderText" Text="Fitur utama"
                                           FontSize="17" FontWeight="SemiBold"
                                           Foreground="#85C8FF" Margin="0,0,0,8"/>
                                <StackPanel Margin="4,0,0,18">
                                    <TextBlock x:Name="AboutFeature1Text"
                                               Text="• Widget jadwal sholat di desktop"
                                               Foreground="#D7E2EE" Margin="0,3"/>
                                    <TextBlock x:Name="AboutFeature2Text" Text="• Adzan otomatis"
                                               Foreground="#D7E2EE" Margin="0,3"/>
                                    <TextBlock x:Name="AboutFeature3Text"
                                               Text="• Al-Quran 114 surah dengan pencarian dan bookmark"
                                               Foreground="#D7E2EE" TextWrapping="Wrap" Margin="0,3"/>
                                    <TextBlock x:Name="AboutFeature4Text"
                                               Text="• Murottal, termasuk Al-Kahf otomatis tiap Jumat"
                                               Foreground="#D7E2EE" TextWrapping="Wrap" Margin="0,3"/>
                                    <TextBlock x:Name="AboutFeature5Text"
                                               Text="• Kalender Masehi dan Hijriah"
                                               Foreground="#D7E2EE" Margin="0,3"/>
                                </StackPanel>
                                <TextBlock x:Name="AboutDeveloperText" Text="Pengembang: Ez Team"
                                           Foreground="#D7E2EE" Margin="0,3"/>
                                <TextBlock x:Name="AboutCompanyText" Text="Perusahaan: Azza Corporation"
                                           Foreground="#D7E2EE" Margin="0,3"/>
                                <TextBlock Foreground="#D7E2EE" Margin="0,3,0,18">
                                    <Run Text="Email: "/>
                                    <Hyperlink x:Name="AboutEmailHyperlink"
                                               NavigateUri="mailto:azzacorp@mail.com"
                                               RequestNavigate="AboutEmailLink_RequestNavigate"
                                               Foreground="#85C8FF">
                                        <Run Text="azzacorp@mail.com"/>
                                    </Hyperlink>
                                </TextBlock>
                                <Button x:Name="AboutGitHubButton" Content="Buka GitHub"
                                        Style="{StaticResource AboutAccentButtonStyle}"
                                        Padding="18,10" HorizontalAlignment="Center"
                                        Click="OpenGitHubButton_Click"/>
                                <TextBlock x:Name="AboutCopyrightText"
                                           Text="© 2026 Azza Corporation. Seluruh hak dilindungi."
                                           Foreground="#AAB8C8" TextAlignment="Center"
                                           Margin="0,20,0,0"/>
                                <TextBlock x:Name="AboutStatusText" Foreground="#85C8FF"
                                           TextAlignment="Center" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </Border>
            </Grid>

            <Grid x:Name="PlaceholderPage" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="PlaceholderTitleText" FontSize="30" FontWeight="SemiBold"
                               Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock Text="Halaman ini akan dibuat pada tahap berikutnya."
                               FontSize="15" Foreground="#9AAABD" Margin="0,10,0,0"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>